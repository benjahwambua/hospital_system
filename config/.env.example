# HMS production environment template
# Set these in Apache/PHP-FPM/systemd/Docker secrets. Do not commit real credentials.
HMS_DB_HOST=localhost
HMS_DB_USER=hms_app
HMS_DB_PASS=CHANGE_ME
HMS_DB_NAME=hms_db

# Optional application URL/base path used by deployment tooling.
HMS_BASE_URL=http://localhost/hospital_system

# Production should always use HTTPS and secure cookies at the web-server/PHP level.
